{% assign profile = include.profile %}
{% assign display_name = profile.name %}
{% if display_name == nil or display_name == "" %}
  {% assign display_name = site.first_name | append: " " | append: site.last_name %}
{% endif %}

{% assign github_username = site.data.socials.github_username %}
{% assign github_url = "" %}
{% if profile and profile.html_url %}
  {% assign github_url = profile.html_url %}
{% elsif github_username %}
  {% assign github_url = "https://github.com/" | append: github_username %}
{% endif %}

<aside class="profile-card">
  <div class="profile-card__media">
    {% if profile and profile.avatar_url %}
      <img class="profile-card__avatar" src="{{ profile.avatar_url }}" alt="{{ display_name }}">
    {% else %}
      <div class="profile-card__avatar-fallback">
        {{ site.first_name | slice: 0, 1 }}{{ site.last_name | slice: 0, 1 }}
      </div>
    {% endif %}
  </div>

  <div class="profile-card__body">
    <h2 class="profile-card__name">{{ display_name }}</h2>

    {% if profile and profile.bio %}
      <p class="profile-card__bio">{{ profile.bio }}</p>
    {% elsif site.description %}
      <p class="profile-card__bio">{{ site.description }}</p>
    {% endif %}

    <div class="profile-card__links">
      {% if github_url != "" %}
        <a href="{{ github_url }}" class="profile-card__link">GitHub</a>
      {% endif %}
      {% if site.data.socials.linkedin_username %}
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" class="profile-card__link">LinkedIn</a>
      {% endif %}
      {% if site.data.socials.email %}
        <a href="mailto:{{ site.data.socials.email }}" class="profile-card__link">Email</a>
      {% endif %}
    </div>
  </div>
</aside>
