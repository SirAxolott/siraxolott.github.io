{% assign repo = include.repo %}
{% assign repo_owner = repo.owner %}
{% assign repo_name = repo.name %}
{% assign repo_url = repo.html_url %}
{% assign repo_desc = repo.description %}
{% assign repo_lang = repo.language %}
{% assign repo_stars = repo.stargazers_count %}
{% assign repo_forks = repo.forks_count %}
{% assign repo_updated = repo.updated_at %}

{% if repo_owner == nil %}
  {% assign repo_parts = repo | split: '/' %}
  {% assign repo_owner = repo_parts[0] %}
  {% assign repo_name = repo_parts[1] %}
  {% assign repo_url = "https://github.com/" | append: repo %}
{% endif %}

{% if repo_name == nil and repo.full_name %}
  {% assign repo_parts = repo.full_name | split: '/' %}
  {% assign repo_owner = repo_parts[0] %}
  {% assign repo_name = repo_parts[1] %}
{% endif %}

<article class="repo-card">
  <a class="repo-card__link" href="{{ repo_url }}">
    <div class="repo-card__header">
      <h3 class="repo-card__title">
        <span class="repo-card__owner">{{ repo_owner }}</span>
        <span class="repo-card__slash">/</span>
        <span class="repo-card__name">{{ repo_name }}</span>
      </h3>
      {% if repo_lang %}
        <span class="repo-card__lang">{{ repo_lang }}</span>
      {% endif %}
    </div>

    {% if repo_desc %}
      <p class="repo-card__desc">{{ repo_desc }}</p>
    {% else %}
      <p class="repo-card__desc repo-card__desc--muted">GitHub repository.</p>
    {% endif %}

    <div class="repo-card__meta">
      {% if repo_stars %}
        <span class="repo-card__stat">Stars: {{ repo_stars }}</span>
      {% endif %}
      {% if repo_forks %}
        <span class="repo-card__stat">Forks: {{ repo_forks }}</span>
      {% endif %}
      {% if repo_updated %}
        <span class="repo-card__updated">Updated {{ repo_updated | date: "%b %d, %Y" }}</span>
      {% endif %}
    </div>
  </a>
</article>
